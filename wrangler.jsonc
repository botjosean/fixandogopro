// Sitio estatico + una sola regla: /youtube/* se reenvia al servidor de Dos Lenguas (worker/index.js).
{
  "name": "fixandogopro",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/youtube", "/youtube/*"]
  }
}
